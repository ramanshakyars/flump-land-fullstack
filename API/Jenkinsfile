pipeline {

    agent any

    environment {
        IMAGE_NAME = "flumpland-app"
        NAMESPACE = "flumpland"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Application') {
            steps {
                dir('API') {
                    sh 'chmod +x mvnw'
                    sh './mvnw clean package -DskipTests'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('API') {
                    sh "docker build -t ${IMAGE_NAME}:latest ."
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                dir('API') {
                    sh '''
                        kubectl apply -f k8s/namespace.yaml
                        kubectl apply -f k8s/deployment.yaml
                        kubectl apply -f k8s/service.yaml

                        kubectl rollout status deployment/flumpland-app -n flumpland
                    '''
                }
            }
        }

        stage('Verify Deployment') {
            steps {
                sh '''
                    echo "===== Nodes ====="
                    kubectl get nodes

                    echo "===== Pods ====="
                    kubectl get pods -n flumpland

                    echo "===== Deployments ====="
                    kubectl get deployments -n flumpland

                    echo "===== Services ====="
                    kubectl get svc -n flumpland
                '''
            }
        }
    }

    post {

        success {
            echo "Deployment completed successfully."
        }

        failure {
            echo "Deployment failed."

            sh '''
                kubectl get events -n flumpland --sort-by=.lastTimestamp || true
                kubectl describe deployment flumpland-app -n flumpland || true
                kubectl get pods -n flumpland || true
            '''
        }
    }
}